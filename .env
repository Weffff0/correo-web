
# Servidor SMTP de Gmail.
SMTP_HOST=smtp.gmail.com

# Puerto SMTP que utiliza STARTTLS.
SMTP_PORT=587

# false porque utilizamos el puerto 587.
SMTP_SECURE=false

# Dirección completa de la cuenta que enviará los correos.
SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación de Google, no la contraseña habitual.
SMTP_PASS=tu_contrasena_de_aplicacion

# Nombre que aparecerá como remitente.
MAIL_FROM_NAME=Mi pagina web

# Puerto local del servidor Node.js.
PORT=3000
